# Puerto local opcional. Render inyecta PORT automáticamente.
PORT=3000
NODE_ENV=development

# Persistencia en Supabase (recomendada para Render gratuito).
# Obtén estos valores en Supabase > Project Settings / Connect > API keys.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR

# No necesitas cambiarlo salvo que uses otro nombre de tabla.
SUPABASE_STATE_TABLE=app_state
